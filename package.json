{
  "name": "sage-mem",
  "description": "Cross-session memory for DeepSeek Harness — plain markdown files, no database, no worker.",
  "version": "2.19.1",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.png",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./typert": "./lib/typert.host.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "skills",
    "NOTICE",
    "icon.png"
  ],
  "scripts": {
    "test": "node test/run.mjs",
    "install:dev": "node scripts/install-dev.mjs",
    "build:client": "node scripts/build-client.mjs",
    "images": "node scripts/make-readme-images.mjs"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18",
    "dsh": ">=0.1.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.1",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.0-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.1",
    "react": "^18.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-client-locale": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-skill-filesystem": ">=0.1.2-rc.1",
    "react": "^18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gezi-wen/sage-mem.git"
  },
  "homepage": "https://github.com/gezi-wen/sage-mem#readme",
  "bugs": {
    "url": "https://github.com/gezi-wen/sage-mem/issues"
  },
  "keywords": [
    "memory",
    "ai-memory",
    "agent-memory",
    "long-term-memory",
    "cross-session-memory",
    "context-management",
    "knowledge-management",
    "markdown",
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "cordis",
    "typert",
    "plugin",
    "ai-agent",
    "agent",
    "claude-code"
  ]
}
